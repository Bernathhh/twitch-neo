{
  "name": "twitch-neo",
  "version": "1.0.7",
  "description": "Next-generation native Twitch client for LG webOS TVs with 1440p60 and ad-free playback",
  "main": "dist/index.html",
  "scripts": {
    "build": "webpack --mode=production",
    "dev": "webpack serve --mode=development",
    "package": "ares-package -n dist",
    "manifest": "node tools/gen-manifest.cjs twitch.neo.manifest.json",
    "release": "npm run build && npm run package && npm run manifest"
  },
  "keywords": [
    "twitch",
    "webos",
    "lg",
    "tv",
    "hls",
    "hevc",
    "1440p60"
  ],
  "author": "Pavel Bernat",
  "license": "GPL-3.0",
  "dependencies": {
    "hls.js": "^1.5.17"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@webos-tools/cli": "^3.2.6",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.1",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
